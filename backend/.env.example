# Server
PORT=5000
FRONTEND_URL=https://your-frontend.railway.app

# Database — Railway sets DATABASE_URL automatically
# Leave DATABASE_URL blank for local dev and fill in individual vars below
DATABASE_URL=

# Local database (used when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=paypro_db

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Yandex Fleet API
YANDEX_API_KEY=your_yandex_api_key
YANDEX_CLIENT_ID=taxi/park/your_park_id
YANDEX_PARK_ID=your_park_id

# Twilio SMS (primary OTP delivery)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Email OTP fallback (nodemailer / Gmail)
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_gmail_app_password
